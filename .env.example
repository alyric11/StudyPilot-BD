# Optional: enables Gemini-powered study guides, tutoring, quizzes, and study plans.
GEMINI_API_KEY=""

# Private token required to edit and publish chapter overviews.
OVERVIEW_ADMIN_TOKEN=""

# Optional: enables live YouTube lesson search. The app remains usable without it.
YOUTUBE_API_KEY=""

# Maximum new chapter-pool searches per Pacific day across all users and servers.
# Defaults to 20. Set 0 to pause fresh searches; valid stored pools remain available.
YOUTUBE_DAILY_SEARCH_LIMIT="20"
