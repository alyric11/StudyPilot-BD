# Optional: enables Gemini-powered study guides, tutoring, quizzes, and study plans.
GEMINI_API_KEY=""

# Private token required to edit and publish chapter overviews.
OVERVIEW_ADMIN_TOKEN=""

# Optional: enables live YouTube lesson search. The app remains usable without it.
YOUTUBE_API_KEY=""

# Maximum new chapter-pool searches per Pacific day across all users and servers.
# Defaults to 20. Set 0 to pause fresh searches; valid stored pools remain available.
YOUTUBE_DAILY_SEARCH_LIMIT="20"

# Temporary video development mode. Both currently default to true in the server.
# Set BOTH to false before public launch to restore the password and daily cap.
# Verified login, short-term rate limits, search caching, and YouTube's quota remain.
VIDEO_DEV_PASSWORD_BYPASS="true"
VIDEO_DEV_UNLIMITED_SEARCH="true"

# Server verifies published Firestore rules before allowing account deletion.
# Leave blank for automatic activation once rules match; false disables deletion.
ACCOUNT_DELETION_RULES_READY=""
